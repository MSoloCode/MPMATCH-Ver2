{
  "name": "mpmatch",
  "version": "0.1.0",
  "description": "Full-stack matching platform with Next.js 14, Prisma, and TypeScript",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --compiler-options {\"module\":\"commonjs\"} prisma/seed.ts",
    "db:sync": "node scripts/sync-databases.js export",
    "db:verify": "node scripts/sync-databases.js verify",
    "db:local": "cross-env DATABASE_URL=file:./prisma/dev.db next dev",
    "db:supabase": "cross-env DATABASE_URL=postgresql://... next dev"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.28.0",
    "@types/leaflet.markercluster": "^1.5.6",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lru-cache": "^11.3.5",
    "lucide-react": "^0.365.0",
    "next": "^14.2.0",
    "next-auth": "^4.24.14",
    "pg": "^8.21.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.12.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.10.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "autoprefixer": "^10.4.17",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "prisma": "^5.8.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
}
