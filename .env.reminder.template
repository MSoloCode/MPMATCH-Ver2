# Environment Configuration Template for ANC Reminder System
# 
# Copy this file to .env.local and fill in your actual values
# The reminder system requires REMINDER_CRON_SECRET to be set

# ============================================================================
# REMINDER SYSTEM CONFIGURATION
# ============================================================================

# Security token for /api/reminders/process endpoint
# Generate with: openssl rand -base64 32
# This prevents unauthorized access to the cron job
# REQUIRED: Must be set for reminders to work
REMINDER_CRON_SECRET=your-super-secret-cron-token-here-generate-with-openssl

# ============================================================================
# SMS GATEWAY CONFIGURATION
# Reminders use the existing SMS service which requires these credentials
# ============================================================================

# Africa's Talking API (Primary Gateway)
# Get credentials: https://africastalking.com/
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_USERNAME=your-africastalking-username

# Twilio API (Fallback Gateway - used if Africa's Talking fails)
# Get credentials: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# ============================================================================
# EXISTING CONFIGURATION (Keep as-is)
# ============================================================================

# Database
DATABASE_URL=file:./prisma/dev.db

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000

# JWT Secret (for auth tokens)
# JWT_SECRET should be a strong random string
JWT_SECRET=your-jwt-secret-key

# ============================================================================
# OPTIONAL: MONITORING & ALERTING
# ============================================================================

# Enable reminder processing logs (set to 'true' for verbose logging)
REMINDER_LOG_VERBOSE=false

# Webhook URL for failure alerts (optional - not yet implemented)
# REMINDER_FAILURE_WEBHOOK_URL=https://your-webhook.com/alerts

# ============================================================================
# NOTES
# ============================================================================
#
# 1. REMINDER_CRON_SECRET:
#    - Must be at least 32 characters (use: openssl rand -base64 32)
#    - Use this value in Authorization header: Bearer <REMINDER_CRON_SECRET>
#    - Change periodically for security
#    - Different per environment (dev, staging, production)
#
# 2. SMS Gateways:
#    - Africa's Talking is tried first
#    - Twilio is fallback if Africa's Talking fails
#    - Both should be configured for reliability
#    - Test credentials with /api/sms/test endpoint (if available)
#
# 3. Deployment:
#    - In production, use environment variables (not .env file)
#    - Never commit .env.local to version control
#    - Use different secrets for each environment
#
# 4. Testing:
#    - Run: npx ts-node test_reminder_system.ts
#    - Manual curl test: curl -X GET http://localhost:3000/api/reminders/process \
#                             -H "Authorization: Bearer <REMINDER_CRON_SECRET>"
